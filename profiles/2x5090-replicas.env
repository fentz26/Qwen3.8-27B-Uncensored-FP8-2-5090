# ============================================================
# Profile B — 2x RTX 5090, two independent replicas
# STATUS: UNTESTED
# ============================================================
# Every value below is a STARTING POINT, not a validated optimum.
# Nothing in this file has been benchmarked on real hardware yet.
# Fill in results/ before changing "UNTESTED" to a measured claim.
# Leading hypothesis for agent/multi-user AGGREGATE throughput.
# One complete model+draft stack per GPU. No NCCL. No TP. No inter-GPU sync.
# Front with router/router.py using sticky sessions for prefix-cache affinity.
#
# REPORTING RULE: results from this profile are aggregate across independent
# requests. Record them as `"aggregate": true` in the result JSON.
. "$(dirname "${BASH_SOURCE[0]}")/_base.env"
GPUS=0,1
BASE_PORT=9000
CTX=131072
KV_K=q4_0
KV_V=q4_0
