# ============================================================
# Profile A-256k — 1x RTX 5090, maximum context
# STATUS: UNTESTED
# ============================================================
# Every value below is a STARTING POINT, not a validated optimum.
# Nothing in this file has been benchmarked on real hardware yet.
# Fill in results/ before changing "UNTESTED" to a measured claim.
# 256K is the model's native ceiling. Starting the server is NOT evidence the
# context is usable — run scripts/validate-context.py and bench/context/needle.py
# at 8K/32K/64K/128K/192K/256K before claiming 256K works.
# Q4 KV is mandatory here for VRAM; measure the quality cost vs Q8/F16 KV.
. "$(dirname "${BASH_SOURCE[0]}")/_base.env"
GPU=0
PORT=9000
CTX=262144
KV_K=q4_0
KV_V=q4_0
UBATCH=512
