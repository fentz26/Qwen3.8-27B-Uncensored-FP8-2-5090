# ============================================================
# Profile A-fast — 1x RTX 5090, speed-oriented
# STATUS: UNTESTED
# ============================================================
# Every value below is a STARTING POINT, not a validated optimum.
# Nothing in this file has been benchmarked on real hardware yet.
# Fill in results/ before changing "UNTESTED" to a measured claim.
# Hypothesis: this is the >100 tok/s candidate on structured/high-acceptance
# workloads (code, JSON, HTML, tool calls). NOT yet demonstrated.
# VRAM estimate only: 17.56 GB target + 1.14 GB draft = ~18.7 GB weights,
# leaving ~13 GB for KV/activations/CUDA graphs on a 32 GB card. Unverified.
. "$(dirname "${BASH_SOURCE[0]}")/_base.env"
GPU=0
PORT=9000
CTX=131072
KV_K=q4_0
KV_V=q4_0
