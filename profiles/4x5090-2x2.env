# ============================================================
# Profile E-alt — 4x RTX 5090 as 2 x (2-GPU layer-split) replicas
# STATUS: UNTESTED
# ============================================================
# Every value below is a STARTING POINT, not a validated optimum.
# Nothing in this file has been benchmarked on real hardware yet.
# Fill in results/ before changing "UNTESTED" to a measured claim.
# Only worth it if a single card genuinely cannot hold the configuration you
# need — e.g. Q6 weights, F16 KV, or full 256K context with high-precision KV.
# Two layer-split replicas: GPU0+1 -> :9000, GPU2+3 -> :9001.
# Launch manually (serve-replicas.sh is one-GPU-per-replica):
#   GPUS=0,1 ./serve-layer.sh 4x5090-2x2 9000 &
#   GPUS=2,3 ./serve-layer.sh 4x5090-2x2 9001 &
. "$(dirname "${BASH_SOURCE[0]}")/_base.env"
MODEL=${MODEL_DIR}/Qwen3.8-27B-UD-Q6_K_XL.gguf
CTX=131072
KV_K=q8_0
KV_V=q8_0
TENSOR_SPLIT=1,1
SPEC_DRAFT_DEVICE=CUDA0
SPEC_DRAFT_NGL=all
