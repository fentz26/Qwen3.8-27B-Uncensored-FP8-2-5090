# ============================================================
# Profile C — 2x RTX 5090, single model, layer split
# STATUS: UNTESTED
# ============================================================
# Every value below is a STARTING POINT, not a validated optimum.
# Nothing in this file has been benchmarked on real hardware yet.
# Fill in results/ before changing "UNTESTED" to a measured claim.
# Pipeline-style model parallelism. Lower interconnect demand than tensor split
# and keeps quantized KV. But the target already fits one card, so this may be
# strictly worse than Profile A. That is the experiment.
#
# Sweep TENSOR_SPLIT to compensate for GPU0 also holding the draft:
#   1,1  (even)  ->  0.9,1.1  ->  0.8,1.2
. "$(dirname "${BASH_SOURCE[0]}")/_base.env"
GPUS=0,1
PORT=9000
CTX=262144
KV_K=q4_0
KV_V=q4_0
TENSOR_SPLIT=1,1
SPEC_DRAFT_DEVICE=CUDA0
SPEC_DRAFT_NGL=all
