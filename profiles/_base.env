# Shared defaults. Profiles source-override these.
# Paths — override per machine.
MODEL_DIR=${MODEL_DIR:-/workspace/models}
MODEL=${MODEL_DIR}/Qwen3.8-27B-UD-Q4_K_XL.gguf
DRAFT_MODEL=${MODEL_DIR}/Qwen3.8-27B-DFlash2-Q4_K_M.gguf

# DFlash2. n-max is clamped by the draft's trained block size; 7 is the value
# upstream's own model card uses. Sweep 2/4/7/max — higher is NOT always faster.
SPEC_TYPE=draft-dflash
SPEC_N_MAX=7

NGL=all
FLASH_ATTN=on
BATCH=2048
UBATCH=512
PARALLEL=1
HOST=0.0.0.0
